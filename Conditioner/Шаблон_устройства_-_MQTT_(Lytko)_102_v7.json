{
  "name": "Кондиционер",
  "manufacturer": "Lytko",
  "model": "102",
  "modelId": "homeassistant/climate/lytko/(.*)/config",
  "services": [
    {
      "name": "Кондиционер",
      "type": "Thermostat",
      "characteristics": [
        {
          "type": "CurrentHeatingCoolingState",
          "link": [
            {
              "type": "String",
              "topicGet": "climate/lytko/(1)/state",
              "inFunc": "JSON.parse(value).mode",
              "map": {
                "0": "off",
                "1": "heat",
                "2": "cool"
              }
            }
          ],
          "validValues": "0,1,2"
        },
        {
          "type": "TargetHeatingCoolingState",
          "link": [
            {
              "type": "String",
              "topicGet": "climate/lytko/(1)/state",
              "topicSet": "climate/lytko/(1)/mode/set",
              "inFunc": "JSON.parse(value).mode",
              "map": {
                "0": "off",
                "1": "heat",
                "2": "cool",
                "3": "auto",
                "-2": "dry",
                "-1": "fan_only",
                "ECO": "eco"
              }
            }
          ],
          "validValues": "0,1,2,3, -2, -1,ECO"
        },
        {
          "type": "CurrentTemperature",
          "link": [
            {
              "type": "Double",
              "topicGet": "climate/lytko/(1)/state",
              "inFunc": "JSON.parse(value).temp"
            }
          ]
        },
        {
          "type": "TargetTemperature",
          "link": [
            {
              "type": "Double",
              "topicGet": "climate/lytko/(1)/state",
              "topicSet": "climate/lytko/(1)/temperature/set",
              "inFunc": "JSON.parse(value).target_temp"
            }
          ],
          "maxValue": 31,
          "minValue": 16,
          "minStep": 1
        },
        {
          "type": "C_FanSpeed",
          "link": [
            {
              "type": "String",
              "topicGet": "climate/lytko/(1)/state",
              "topicSet": "climate/lytko/(1)/fan/set",
              "inFunc": "JSON.parse(value).fan_speed",
              "map": {
                "0": "auto",
                "1": "quiet",
                "2": "2",
                "3": "3",
                "4": "4",
                "5": "turbo"
              }
            }
          ],
          "validValues": "0,1,2,3,4,5"
        },
        {
          "type": "SwingMode",
          "link": [
            {
              "type": "String",
              "topicGet": "climate/lytko/(1)/state",
              "topicSet": "climate/lytko/(1)/swing/set",
              "inFunc": "JSON.parse(value).swing",
              "map": {
                "0": "off",
                "1": "both",
                "-1": "vertical",
                "-2": "horizontal"
              }
            }
          ],
          "validValues": "0,1, -1, -2"
        }
      ]
    },
    {
      "type": "Switch",
      "name": "@Подсветка",
      "characteristics": [
        {
          "type": "On",
          "link": [
            {
              "type": "String",
              "topicGet": "climate/lytko/(1)/state",
              "topicSet": "switch/lytko/(1)l/led/set",
              "inFunc": "JSON.parse(value).led === 'on'",
              "map": {
                "true": "on",
                "false": "off"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Switch",
      "name": "@Зуммер",
      "characteristics": [
        {
          "type": "On",
          "link": [
            {
              "type": "String",
              "topicGet": "climate/lytko/(1)/state",
              "topicSet": "switch/lytko/(1)b/beep/set",
              "inFunc": "JSON.parse(value).beep === 'on'",
              "map": {
                "true": "on",
                "false": "off"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Switch",
      "name": "Здоровье",
      "characteristics": [
        {
          "type": "On",
          "link": [
            {
              "type": "String",
              "topicGet": "climate/lytko/(1)/state",
              "topicSet": "switch/lytko/(1)h/health/set",
              "inFunc": "JSON.parse(value).health === 'on'",
              "map": {
                "true": "on",
                "false": "off"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Switch",
      "name": "Сон",
      "characteristics": [
        {
          "type": "On",
          "link": [
            {
              "type": "String",
              "topicGet": "climate/lytko/(1)/state",
              "topicSet": "switch/lytko/(1)s/sleep/set",
              "inFunc": "JSON.parse(value).sleep === 'on'",
              "map": {
                "true": "on",
                "false": "off"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Switch",
      "name": "Блокировка пульта",
      "characteristics": [
        {
          "type": "On",
          "link": [
            {
              "type": "String",
              "topicGet": "climate/lytko/(1)/state",
              "topicSet": "switch/lytko/(1)k/lock_remote/set",
              "inFunc": "JSON.parse(value).lock_remote === 'on'",
              "map": {
                "true": "on",
                "false": "off"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Switch",
      "name": "Самоочистка",
      "characteristics": [
        {
          "type": "On",
          "link": [
            {
              "type": "String",
              "topicGet": "climate/lytko/(1)/state",
              "topicSet": "switch/lytko/(1)sc/self_clean/set",
              "inFunc": "JSON.parse(value).self_clean === 'on'",
              "map": {
                "true": "on",
                "false": "off"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "TemperatureSensor",
      "name": "Уличная температура",
      "characteristics": [
        {
          "type": "CurrentTemperature",
          "link": [
            {
              "type": "Double",
              "topicGet": "climate/lytko/(1)/state",
              "inFunc": "JSON.parse(value).t_outdoor"
            }
          ]
        }
      ]
    },
    {
      "type": "C_Option",
      "name": "Код ошибки",
      "characteristics": [
        {
          "type": "C_Integer",
          "write": false,
          "link": [
            {
              "type": "Integer",
              "topicGet": "climate/lytko/(1)/state",
              "inFunc": "JSON.parse(value).error_code"
            }
          ]
        }
      ]
    },
    {
      "type": "C_Option",
      "name": "Время самоочистки",
      "characteristics": [
        {
          "type": "C_Integer",
          "link": [
            {
              "type": "Integer",
              "topicGet": "climate/lytko/(1)/state",
              "inFunc": "JSON.parse(value).cleaning_time"
            }
          ]
        }
      ]
    },
    {
      "name": "Качание жалюзи (вертикально)",
      "type": "Television",
      "characteristics": [
        {
          "type": "Active",
          "name": "Режим",
          "link": [
            {
              "type": "String",
              "topicGet": "climate/lytko/(1)/state",
              "inFunc": "JSON.parse(value).mode !== '0'",
              "map": {
                "true": "on",
                "false": "off"
              }
            }
          ]
        },
        {
          "type": "ActiveIdentifier",
          "description": "1 - Верх, 2 - Выше центра, 3 - Центр, 4 - Ниже центра, 5 - Вниз",
          "link": [
            {
              "type": "String",
              "topicGet": "climate/lytko/(1)/state",
              "topicSet": "climate/lytko/(1)/swing_vertical/set",
              "inFunc": "({'MAX_UP':1,'UP':2,'CENTER_V':3,'DOWN':4,'MAX_DOWN':5})[JSON.parse(value).vswing] || 1",
              "outFunc": "(['', 'MAX_UP', 'UP', 'CENTER_V', 'DOWN', 'MAX_DOWN'])[value]"
            }
          ]
        },
        {
          "type": "ConfiguredName",
          "name": "Режим работы",
          "write": false,
          "link": [
            {
              "type": "String",
              "write": false,
              "topicGet": "climate/lytko/(1)/state",
              "inFunc": "({'MAX_UP':'Верх','UP':'Выше центра','CENTER_V':'Центр','DOWN':'Ниже центра','MAX_DOWN':'Вниз'})[JSON.parse(value).vswing] || 'Качание жалюзи'"
            }
          ]
        },
        {
          "type": "SleepDiscoveryMode",
          "value": 1
        }
      ]
    },
    {
      "name": "Верх",
      "type": "InputSource",
      "characteristics": [
        {
          "type": "Identifier",
          "value": 1
        },
        {
          "type": "ConfiguredName",
          "value": "Верх"
        },
        {
          "type": "IsConfigured",
          "value": 1
        },
        {
          "type": "CurrentVisibilityState",
          "value": 0
        }
      ]
    },
    {
      "name": "Выше центра",
      "type": "InputSource",
      "characteristics": [
        {
          "type": "Identifier",
          "value": 2
        },
        {
          "type": "ConfiguredName",
          "value": "Выше центра"
        },
        {
          "type": "IsConfigured",
          "value": 1
        },
        {
          "type": "CurrentVisibilityState",
          "value": 0
        }
      ]
    },
    {
      "name": "Центр",
      "type": "InputSource",
      "characteristics": [
        {
          "type": "Identifier",
          "value": 3
        },
        {
          "type": "ConfiguredName",
          "value": "Центр"
        },
        {
          "type": "IsConfigured",
          "value": 1
        },
        {
          "type": "CurrentVisibilityState",
          "value": 0
        }
      ]
    },
    {
      "name": "Ниже центра",
      "type": "InputSource",
      "characteristics": [
        {
          "type": "Identifier",
          "value": 4
        },
        {
          "type": "ConfiguredName",
          "value": "Ниже центра"
        },
        {
          "type": "IsConfigured",
          "value": 1
        },
        {
          "type": "CurrentVisibilityState",
          "value": 0
        }
      ]
    },
    {
      "name": "Вниз",
      "type": "InputSource",
      "characteristics": [
        {
          "type": "Identifier",
          "value": 5
        },
        {
          "type": "ConfiguredName",
          "value": "Вниз"
        },
        {
          "type": "IsConfigured",
          "value": 1
        },
        {
          "type": "CurrentVisibilityState",
          "value": 0
        }
      ]
    }
  ]
}
